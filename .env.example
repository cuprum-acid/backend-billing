# Environment variables for local development
# Copy this file to .env and customize as needed

# Server
PORT=8080

# Database
DATABASE_URL=host=localhost user=postgres password=password dbname=billing port=5432 sslmode=disable

# Or component-based (alternative)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=billing
DB_SSLMODE=disable

# Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4318
TRACING_SERVICE=billing-api
